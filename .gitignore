# Dependencies
node_modules
.pnpm-store

# Build outputs
dist
out
.next
.turbo
# Anchored to the repo root. A bare `build` matches any directory of that name
# at any depth, which silently excluded every transaction-building API route
# under app/api/*/build — a clone had no swap, offer, plan or lend builder at
# all, and nothing failed loudly enough to notice.
/build

# Environment
.env
.env.local
.env.*.local

# Go
backend/bin/
*.exe
*.test
*.out

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
!contracts/broadcast/*/31337/
!contracts/broadcast/**/*dry-run/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode
.idea
*.swp
*.swo

# Coverage
coverage/
lcov.info

# Turbo
.turbo

# Docker volumes
postgres-data/
redis-data/

# Supabase
supabase/.branches
supabase/.temp
# Market research (never push)
docs/Intent Market Research.pdf

# Internal planning docs (local only)
docs/PRODUCT.md
docs/PERMISSIONS.md
docs/CONVERSATION.md

# Build artifacts
*.tsbuildinfo

# Superpowers scratch
.superpowers/

# Eval run output. Regenerable with `pnpm agents:eval`, and one file per run
# would accumulate; the conclusions live in evals/RESULTS.md instead.
apps/dapp/lib/agents/evals/results/

# Playwright output: the HTML report and the traces of failed runs. CI
# uploads the report as an artifact when the smoke suite fails.
apps/dapp/playwright-report/
apps/dapp/test-results/
