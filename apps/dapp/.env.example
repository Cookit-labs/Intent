NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# WalletConnect project id from https://cloud.reown.com
# Injected wallets (MetaMask, Rabby) work without this; WalletConnect and
# mobile wallets do not.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Arc testnet RPC. Defaults to the public endpoint when unset.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# --- Access gate ---
DATABASE_URL=postgresql://intent:intent_local_dev@localhost:55432/intent
REDIS_URL=redis://localhost:56379
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Min 16 chars. Guards /api/admin/waitlist and the /admin/waitlist page.
ADMIN_TOKEN=
# Optional in dev (codes log to console); required in production.
RESEND_API_KEY=
EMAIL_FROM=

# --- Agents ---
# Server-side only: never prefix these with NEXT_PUBLIC_, or the key ships to
# the browser. Unset means agents fall back to simulated proposals.
AGENT_BRAIN=mock
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Strict tool schemas live on the /beta endpoint. Set to false to use the
# standard one; responses are validated application-side either way.
DEEPSEEK_STRICT_TOOLS=true
# Client flag: routes the competition through the agent endpoint.
NEXT_PUBLIC_USE_AI=false
