NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# WalletConnect project id from https://cloud.reown.com
# Injected wallets (MetaMask, Rabby) work without this; WalletConnect and
# mobile wallets do not.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Arc testnet RPC. Defaults to the public endpoint when unset.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# --- Access gate ---
DATABASE_URL=postgresql://intent:intent_local_dev@localhost:55432/intent
REDIS_URL=redis://localhost:56379
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Fee sponsorship. With a secret key here the server wraps every signed
# transaction in a fee-bump it pays for, so a user holding only USDC can still
# trade. On testnet the account funds itself from friendbot on first use.
# Users still need the 1 XLM base reserve to hold an account at all; this
# covers fees, not reserves.
SPONSOR_SECRET_KEY=
# Min 16 chars. Guards /api/admin/waitlist and the /admin/waitlist page.
ADMIN_TOKEN=
# Optional in dev (codes log to console); required in production.
RESEND_API_KEY=
EMAIL_FROM=

# The line-up. One entry per agent, in display order; the number of entries is
# the number of agents that race. An entry is a provider, or provider/model
# where model is a short name from the provider's table or a raw catalogue id.
# Leave unset to race every configured model: each provider's default plus all
# five curated OpenRouter models when that key is set (seven with the three
# hosted keys). Groq holds one agent: its free tier allows 8,000 tokens a
# minute and one prompt costs ~2,300. An entry whose key is missing is dropped
# with a warning, never swapped.
# AGENT_BRAINS=deepseek,groq,openrouter/ling-fin,openrouter/nemotron-super,openrouter/gemma-4

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Strict tool schemas live on the /beta endpoint. Set to false to use the
# standard one; responses are validated application-side either way.
DEEPSEEK_STRICT_TOOLS=true

# Groq's free plan — no card required. https://console.groq.com/keys
# The binding limit is 8,000 tokens per minute, not the 30 requests: four
# agents racing at once can exceed it and come back 429.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter's free tier — no card required. https://openrouter.ai/keys
# One key fronts every free model, and that is where the variety comes from:
# name a model after the provider in AGENT_BRAINS and each agent gets its own.
# Short names: ling-fin, nemotron-super, gemma-4, laguna-s, north-mini (see
# lib/agents/brains/providers.ts). Anything else is passed through as a raw
# catalogue id, e.g. openrouter/nvidia/nemotron-3-ultra-550b-a55b:free.
#   AGENT_BRAINS=deepseek,groq,openrouter/ling-fin,openrouter/nemotron-super,openrouter/gemma-4
# Limits are per key across every free model: 20 requests a minute, and
# 50 a day until 10 credits have ever been bought (1,000 a day after). The
# default roster puts five agents here: ten races a day untopped, 200 after.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=ling-fin

# A model running locally via Ollama. Needs no key, and is unreachable from a
# deployed build — 127.0.0.1 is not the deploy host. Never selected unless
# named in AGENT_BRAINS, because a daemon that is not running looks exactly
# like one that is until every agent fails at once.
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Client flag: routes the competition through the agent endpoint.
NEXT_PUBLIC_USE_AI=false
