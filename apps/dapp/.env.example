NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# WalletConnect project id from https://cloud.reown.com
# Injected wallets (MetaMask, Rabby) work without this; WalletConnect and
# mobile wallets do not.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Arc testnet RPC. Defaults to the public endpoint when unset.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# --- Stellar network ---
# Which Stellar network the dapp executes on: testnet (the default) or mainnet.
# Anything else refuses to boot. Flipping to mainnet needs, at the least:
#   - a funded mainnet sponsor in SPONSOR_SECRET_KEY: there is no friendbot,
#     and an unfunded sponsor means users pay their own fees;
#   - an RPC you trust in NEXT_PUBLIC_SOROBAN_RPC_URL (the public
#     mainnet.sorobanrpc.com is fine to start) and, if you run one, a Horizon
#     in NEXT_PUBLIC_STELLAR_HORIZON_URL — both override the active network only;
#   - wallets on the public network: the app compares passphrases and asks
#     for Stellar Mainnet;
#   - knowing that Soroswap, its aggregator (needs SOROSWAP_API_KEY), Aquarius,
#     the classic DEX, the network's liquidity pools, Blend and Soroban
#     Domains are on mainnet, plus Etherfuse's CETES and USTRY bonds. DeFindex,
#     Noether and every anchor stay testnet-only until their mainnet details
#     are verified in the code;
#   - no fiat off-ramp unless MoneyGram's production domain is set below.
# Every trade is capped in dollars on mainnet; see MAINNET_MAX_TRADE_USD.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# The Stellar networks this deployment serves, as a comma list that includes the
# default above, for example testnet,mainnet. Unset, only the default is served
# and nothing about the app changes. With more than one:
#   - pages live under /stellar-mainnet and /stellar-testnet, and the old
#     /stellar address redirects to the default network's;
#   - the chain menu lists each network and switching loads the page afresh;
#   - every network has its own fee sponsor (SPONSOR_SECRET_KEY_TESTNET and
#     SPONSOR_SECRET_KEY_MAINNET; the plain SPONSOR_SECRET_KEY serves only the
#     default network), its own spend ledger, standing rules, rate-limit
#     buckets, saved wallet sessions and health report (/api/health?network=);
#   - the access gate follows the network when ACCESS_GATE is unset: mainnet
#     needs the email-code login, testnet stays open;
#   - the scheduled rule check runs each network on its own.
# Needs a funded mainnet sponsor and a database before mainnet is usable.
NEXT_PUBLIC_STELLAR_NETWORKS=
# Where the other Stellar network is deployed, for a deployment that serves only
# one (a mainnet deployment points at the testnet one, and the other way round).
# Adds it to the chain menu as a link. Ignored when NEXT_PUBLIC_STELLAR_NETWORKS
# lists both networks. Leave empty and the menu shows it as not set up.
NEXT_PUBLIC_STELLAR_OTHER_NETWORK_URL=
# The most one trade may be worth on mainnet, in dollars, checked against the
# same prices the agents reason from. Ignored on testnet. Default 50.
MAINNET_MAX_TRADE_USD=50
# MoneyGram's production home domain (stellar.moneygram.com), which turns the
# anchor on for mainnet. Needs MoneyGram's commercial agreement and a
# client_domain this deployment does not yet have; unset, mainnet has no
# off-ramp and says so.
MONEYGRAM_PRODUCTION_HOME_DOMAIN=

# --- Access gate ---
DATABASE_URL=postgresql://intent:intent_local_dev@localhost:55432/intent
REDIS_URL=redis://localhost:56379
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# on | off. Whether the OTP gate in front of the app pages runs. Unset, it
# follows the network: on for mainnet, off for testnet. The API is outside
# the gate, but with it on the fee sponsor pays only for a request that
# carries the session it issues; anything else submits paying its own fee.
ACCESS_GATE=

# --- Rate limits ---
# Per client address, per family of route, as count/seconds. Counted in
# Postgres so the limit holds across instances; with no reachable database
# every request is allowed and one warning is logged. Families: build
# (quotes and transaction builds), submit, compete (intent parsing and the
# agent race), resolve (name lookups), standing (rules and inbox) and auth
# (otp, waitlist, admin, perps key session). These are the defaults from
# lib/server/rate-limit.ts; set one to change it.
# The address comes from the platform's own header: on Netlify
# x-nf-client-connection-ip, on Vercel (VERCEL is set there) x-vercel-forwarded-for
# then x-real-ip. The Netlify header is ignored on Vercel, which does not strip
# the client's copy. Behind any other proxy that only appends to
# x-forwarded-for, a client can choose its own bucket.
# RATE_LIMIT_BUILD=30/60
# RATE_LIMIT_SUBMIT=10/60
# RATE_LIMIT_COMPETE=10/60
# RATE_LIMIT_RESOLVE=30/60
# RATE_LIMIT_STANDING=30/60
# RATE_LIMIT_AUTH=10/60

# Fee sponsorship. With a secret key here the server wraps every signed
# transaction in a fee-bump it pays for, so a user holding only USDC can still
# trade. On testnet the account funds itself from friendbot on first use.
# Users still need the 1 XLM base reserve to hold an account at all; this
# covers fees, not reserves.
# Needs DATABASE_URL: the budget below is kept there, and with no database
# configured the key pays for nothing (every submission goes out unsponsored
# with reason no_ledger, and GET /api/sponsor says so).
SPONSOR_SECRET_KEY=
# When several Stellar networks are served, a key per network. The plain key above
# serves the default network only, so a testnet key can never pay on mainnet.
SPONSOR_SECRET_KEY_TESTNET=
SPONSOR_SECRET_KEY_MAINNET=
# The most the sponsor pays in a day, in XLM, and how many sponsored
# submissions any one account gets in a day. Past either, the transaction
# goes out paying its own fee. 0 sponsors nothing without removing the key.
SPONSOR_DAILY_BUDGET_XLM=50
SPONSOR_DAILY_PER_ACCOUNT=20
# Min 16 chars. Guards /api/admin/waitlist and the /admin/waitlist page.
ADMIN_TOKEN=
# Optional in dev (codes log to console); required in production.
RESEND_API_KEY=
EMAIL_FROM=

# The line-up. One entry per agent, in display order; the number of entries is
# the number of agents that race. An entry is a provider, or provider/model
# where model is a short name from the provider's table or a raw catalogue id.
# Leave unset to race every configured model: each provider's default plus all
# five curated OpenRouter models when that key is set (seven with the three
# hosted keys). Groq holds one agent: its free tier allows 8,000 tokens a
# minute and one prompt costs ~2,300. An entry whose key is missing is dropped
# with a warning, never swapped.
# AGENT_BRAINS=deepseek,groq,openrouter/ling-fin,openrouter/nemotron-super,openrouter/gemma-4

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Strict tool schemas live on the /beta endpoint. Set to false to use the
# standard one; responses are validated application-side either way.
DEEPSEEK_STRICT_TOOLS=true

# Groq's free plan — no card required. https://console.groq.com/keys
# The binding limit is 8,000 tokens per minute, not the 30 requests: four
# agents racing at once can exceed it and come back 429.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter's free tier — no card required. https://openrouter.ai/keys
# One key fronts every free model, and that is where the variety comes from:
# name a model after the provider in AGENT_BRAINS and each agent gets its own.
# Short names: ling-fin, nemotron-super, gemma-4, laguna-s, north-mini (see
# lib/agents/brains/providers.ts). Anything else is passed through as a raw
# catalogue id, e.g. openrouter/nvidia/nemotron-3-ultra-550b-a55b:free.
#   AGENT_BRAINS=deepseek,groq,openrouter/ling-fin,openrouter/nemotron-super,openrouter/gemma-4
# Limits are per key across every free model: 20 requests a minute, and
# 50 a day until 10 credits have ever been bought (1,000 a day after). The
# default roster puts five agents here: ten races a day untopped, 200 after.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=ling-fin

# A model running locally via Ollama. Needs no key, and is unreachable from a
# deployed build — 127.0.0.1 is not the deploy host. Never selected unless
# named in AGENT_BRAINS, because a daemon that is not running looks exactly
# like one that is until every agent fails at once.
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Client flag: routes the competition through the agent endpoint.
NEXT_PUBLIC_USE_AI=false

# Soroswap's aggregator API. Free key (starts with sk_) from
# https://api.soroswap.finance/register. Adds one more quote source that splits
# a swap across Soroswap, Aquarius and the classic DEX and returns the unsigned
# transaction, which is re-read against the quote before a wallet sees it.
# Unset, the aggregator is simply absent from the line-up.
SOROSWAP_API_KEY=

# DeFindex yield vaults: a second lending venue beside Blend. Key from
# https://console.defindex.io (one key serves both networks; this app asks
# only for testnet). Unset, DeFindex is absent from what the agents are
# offered and nothing else changes.
DEFINDEX_API_KEY=

# Noether perps gateway. The SDK default api.noether.exchange does not
# resolve; this Azure host was taken from the production bundle and answers.
# Testnet only; the gateway reports version 0.0.0-dev and is unaudited.
# NOETHER_API_URL=https://noether-api.proudmeadow-533cf0d8.germanywestcentral.azurecontainerapps.io
NOETHER_API_URL=

# --- Standing rules ---
# Origin the fired-rule emails link into, e.g. https://intent.example (no trailing slash).
APP_URL=http://localhost:3001
# Min 16 chars. Guards POST /api/standing/tick, which evaluates every armed rule.
# In development run `pnpm standing:tick`; in production call the route from a cron or scheduled function.
STANDING_TICK_SECRET=

# --- Monitoring ---
# Sentry. With neither set, nothing is loaded and nothing is sent. The server
# DSN covers API routes and the tick; the public one covers the browser
# bundle. The build never uploads source maps, so no auth token is needed.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Where operator alerts go. Unset, none are sent. The one alert today: the fee
# sponsor's balance has fallen below SPONSOR_ALERT_XLM — sent by the tick, once
# a day while it stays there.
ALERT_EMAIL=
SPONSOR_ALERT_XLM=20
