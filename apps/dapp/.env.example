NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# WalletConnect project id from https://cloud.reown.com
# Injected wallets (MetaMask, Rabby) work without this; WalletConnect and
# mobile wallets do not.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Arc testnet RPC. Defaults to the public endpoint when unset.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# --- Access gate ---
DATABASE_URL=postgresql://intent:intent_local_dev@localhost:55432/intent
REDIS_URL=redis://localhost:56379
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Min 16 chars. Guards /api/admin/waitlist and the /admin/waitlist page.
ADMIN_TOKEN=
# Optional in dev (codes log to console); required in production.
RESEND_API_KEY=
EMAIL_FROM=

# --- Agents ---
# Server-side only: never prefix these with NEXT_PUBLIC_, or the key ships to
# the browser. With no provider configured the agents are offline and the app
# says so — there are no simulated proposals.
#
# Which model each of the four agents runs on, in display order
# (Atlas, Meridian, Cobalt, Halcyon). Four agents on one model are four
# samples of one mind and tend to agree; different models disagree for real
# reasons, which is what the competition is for. Unset spreads whichever
# providers have keys across the four.
#   AGENT_BRAINS=deepseek,ollama,groq,deepseek
AGENT_BRAINS=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Strict tool schemas live on the /beta endpoint. Set to false to use the
# standard one; responses are validated application-side either way.
DEEPSEEK_STRICT_TOOLS=true

# Groq's free plan — no card required. https://console.groq.com/keys
# The binding limit is 8,000 tokens per minute, not the 30 requests: four
# agents racing at once can exceed it and come back 429.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# A model running locally via Ollama. Needs no key, and is unreachable from a
# deployed build — 127.0.0.1 is not the deploy host. Never selected unless
# named in AGENT_BRAINS, because a daemon that is not running looks exactly
# like one that is until every agent fails at once.
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Client flag: routes the competition through the agent endpoint.
NEXT_PUBLIC_USE_AI=false
