# The public dApp, read at build time by the Launch dApp menu. Production
# builds only: development keeps using .env.local, so the menu points at the
# local dApp there. Not a secret, so it lives in the repo rather than in the
# host's settings, and a preview build links to the same dApp as production.
NEXT_PUBLIC_DAPP_URL=https://useintentadapp.netlify.app
