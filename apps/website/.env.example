NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Origin the dApp is served from. No default in code on purpose: a
# hardcoded localhost port can be occupied by an unrelated project, which
# would send users to the wrong app silently. Unset = Arc option disabled.
NEXT_PUBLIC_DAPP_URL=http://localhost:3001
